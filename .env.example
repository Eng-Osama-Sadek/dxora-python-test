# Copy this file to ".env" and fill in ONE provider key. NEVER commit the real .env file.

# --- Which LLM to use: gemini (default, has a FREE tier) | openai | anthropic
LLM_PROVIDER=gemini

# Free key (no credit card): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional alternatives
OPENAI_API_KEY=
# OPENAI_BASE_URL also works with OpenAI-compatible providers (Groq, OpenRouter, ...)
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=

# --- Optional: override the default models (leave empty to use the defaults)
#   gemini    -> gemini-3.8-flash   (fallback: gemini-3.5-flash-lite)
#   openai    -> gpt-5.4-nano       (fallback: gpt-5.4-mini)
#   anthropic -> claude-haiku-5-5   (fallback: claude-sonnet-5-5)
LLM_MODEL=
# Use "none" to disable the automatic fallback model
LLM_FALLBACK_MODEL=

# --- Tuning
FETCH_TIMEOUT=15
LLM_TIMEOUT=90
MAX_CONTENT_CHARS=12000
CACHE_TTL_SECONDS=3600
